# Platform MySQL URL: provide via process environment. Never commit real credentials.
DATABASE_URL=
# Random secret of at least 32 characters, stored securely and stable across restarts.
BETTER_AUTH_SECRET=
# Exact origin from which the browser opens the frontend.
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=3000
# API diagnostics; the optional LOG_DIR override must be an absolute path.
# Default: apps/community-api/.runtime/logs (relative to the repository root).
# LOG_DIR=
LOG_LEVEL=info
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=7
LOG_STDOUT_ONLY=0
# Enable only after explicitly applying the stage-3 migration to the selected platform database.
ENABLE_STAGE3_DATASOURCES=0
# Read-only query execution remains opt-in and requires the phase-3 data source feature.
ENABLE_STAGE4_READS=0
# Enables semantic management after explicit stage-6 migration. Existing policies remain enforced even when 0.
ENABLE_STAGE6_SEMANTICS=0
# Local history, definitions, execution journal and audit. Apply explicit stage-7 migration first.
# Requires stage-3, stage-4 and stage-6; no automatic startup migration.
ENABLE_STAGE7_HISTORY=0
