{
  "name": "ai-database-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "biome format apps/community-api/src apps/community-api/test apps/community-web/src packages/ui/src scripts",
    "lint": "biome lint apps/community-api/src apps/community-api/test apps/community-web/src packages/ui/src scripts",
    "check:boundaries": "node scripts/check-boundaries.mjs --self-test && node scripts/check-boundaries.mjs",
    "db:design-validate": "prisma validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "dotenv": "17.2.3",
    "prisma": "7.10.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
