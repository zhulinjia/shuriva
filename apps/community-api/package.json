{
  "name": "@workspace/community-api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/src",
    "migrations/*.sql",
    "bin/mcp-host.exe",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "admin:create": "node dist/src/create-admin.js",
    "db:migrate": "pnpm run build && node dist/src/migrations.js",
    "db:migrate:stage3": "pnpm run build && node dist/src/migrations.js --stage3",
    "db:migrate:stage6": "pnpm run build && node dist/src/migrations.js --stage6",
    "db:migrate:stage7": "pnpm run build && node dist/src/migrations.js --stage7",
    "db:migrate:stage8": "pnpm run build && node dist/src/migrations.js --stage8",
    "db:migrate:bindings": "pnpm run build && node dist/src/binding-migrate.js",
    "db:migrate:mcp": "pnpm run build && node dist/src/mcp-migrate.js",
    "mcp:local:login": "node dist/src/mcp-local-login.js",
    "mcp:stdio": "node dist/src/mcp-stdio.js",
    "db:migrate:mcp-client": "pnpm run build && node dist/src/mcp-client-migrate.js",
    "mcp:host:build": "node ../../scripts/build-mcp-host.mjs",
    "mcp:program:install": "node dist/src/mcp-program-install.js",
    "admin:reset-password": "node dist/src/reset-admin.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.76",
    "@better-auth/kysely-adapter": "1.7.14",
    "@better-auth/mcp": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/utils": "0.5.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@shuriva/core-contracts": "workspace:*",
    "ai": "7.0.149",
    "ajv": "8.18.0",
    "better-auth": "1.7.14",
    "eventsource-parser": "3.1.1",
    "express": "5.1.0",
    "koffi": "3.3.6",
    "kysely": "0.29.7",
    "mysql2": "3.24.4",
    "parse5": "8.0.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rotating-file-stream": "3.2.10",
    "rxjs": "7.8.2",
    "selfsigned": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
